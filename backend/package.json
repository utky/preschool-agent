    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "hono": "^4.13.19",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
