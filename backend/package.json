{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --passWithNoTests",
